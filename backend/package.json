{
  "name": "client-portal-backend",
  "version": "1.0.0",
  "description": "API and static server for the client portal — intake forms, SEO/contact submissions, and admin auth.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=65 --test-coverage-branches=65 --test-coverage-functions=42",
    "guardian": "node guardian/runGuardian.js",
    "guardian:ai": "node guardian/reviewCli.js",
    "guardian:smoke": "node guardian/smokeTest.js"
  },
  "engines": {
    "node": "26.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@sentry/node": "^10.73.0",
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "resend": "^6.25.0",
    "undici": "^8.10.1",
    "zod": "^4.5.4"
  }
}
