# Copy this file to .env and adjust values before running the server.

PORT=8743

# Signs and verifies admin JWTs — replace with a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seeded automatically on first run if no admin user exists yet.
ADMIN_EMAIL=admin@studio.dev
ADMIN_PASSWORD=studio-admin

# Postgres connection string, from Supabase: Project Settings → Database →
# Connection string (the "Transaction pooler" URI works well for a small
# app like this; use the direct connection URI if you hit pooler issues).
# Falls back to a local Postgres for development if unset.
DATABASE_URL=postgresql://user:password@db.your-project-ref.supabase.co:5432/postgres

# Email notifications (optional) — sent via Resend when a new submission
# comes in. Leave RESEND_API_KEY unset to skip notifications entirely;
# submissions still save normally either way.
# Get a key at https://resend.com — the free tier works fine for this.
RESEND_API_KEY=
# Where notifications get sent (you).
NOTIFY_EMAIL=
# Resend's shared sandbox sender works without verifying a domain. Once you
# verify your own domain in Resend, switch this to e.g. notify@yourdomain.com.
NOTIFY_FROM_EMAIL=onboarding@resend.dev
