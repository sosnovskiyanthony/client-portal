# Copy this file to .env and adjust values before running the server.

# Set to "production" on Railway (or any real deployment) — this is what
# makes JWT_SECRET/ADMIN_EMAIL/ADMIN_PASSWORD fail loudly at boot if unset,
# instead of silently falling back to an insecure dev-only default. Leave
# unset for local development.
NODE_ENV=production

PORT=8743

# Signs and verifies admin JWTs — replace with a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seeded automatically on first run if no admin user exists yet.
ADMIN_EMAIL=admin@brindleaf.dev
ADMIN_PASSWORD=brindleaf-admin

# Postgres connection string, from Supabase: Project Settings → Database →
# Connection string (the "Transaction pooler" URI works well for a small
# app like this; use the direct connection URI if you hit pooler issues).
# Falls back to a local Postgres for development if unset.
DATABASE_URL=postgresql://user:password@db.your-project-ref.supabase.co:5432/postgres

# Email notifications (optional) — sent via Resend when a new submission
# comes in. Leave RESEND_API_KEY unset to skip notifications entirely;
# submissions still save normally either way.
# Get a key at https://resend.com — the free tier works fine for this.
RESEND_API_KEY=
# Where notifications get sent (you).
NOTIFY_EMAIL=
# Resend's shared sandbox sender works without verifying a domain. Once you
# verify your own domain in Resend, switch this to e.g. notify@yourdomain.com.
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# Canonical production URL (no trailing slash), used for canonical links, Open
# Graph tags, JSON-LD, and the sitemap. Leave unset until a real custom domain
# exists — it defaults to the current Railway URL. Once you have a domain,
# set it here and every page updates automatically at serve time.
SITE_URL=https://client-portal-production-d328.up.railway.app

# Google Analytics 4 Measurement ID (starts with G-), for YOUR OWN GA
# property — get it from analytics.google.com, Admin > Data Streams. Leave
# unset (the default) to disable analytics entirely. Even when set, GA is
# never loaded until a visitor accepts the consent banner (see
# frontend/js/analytics.js) — no analytics cookie is set before that.
GA_MEASUREMENT_ID=

# --- AI project analysis (ai/aiService.js) ---
#
# "ollama" (default): free, runs locally, no API key, $0 per request. Install
# Ollama and pull a model first — see backend/ai/README.md for exact commands.
# "anthropic": built but dormant — only takes effect if you also set
# ANTHROPIC_API_KEY below. Real, billed API calls only happen if you
# explicitly choose this.
AI_PROVIDER=ollama

# Where your local (or self-hosted) Ollama server is running. Defaults to the
# same machine. Never point this at a publicly-reachable Ollama instance —
# its API has no authentication of its own.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Required in production for AI features to work at all — without this,
# scripts/start-with-tailscale.sh skips connecting to the tailnet entirely,
# and every AI feature fails with "Ollama unavailable" (everything else in
# the app is unaffected). Generate a key at
# https://login.tailscale.com/admin/settings/keys. Not read directly by the
# Node app — only by the startup script, before the app itself even starts.
TAILSCALE_AUTHKEY=

# Only read when AI_PROVIDER=anthropic. Leave both unset while using Ollama.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Bump this whenever ai/prompt.js's SYSTEM_PROMPT text changes meaningfully —
# stored with every analysis so you can compare results across prompt
# revisions later. Defaults to "1.0" if unset.
AI_PROMPT_VERSION=1.0

# Same idea as AI_PROMPT_VERSION above, for ai/chatPrompt.js's
# CHAT_SYSTEM_PROMPT (the AI chat feature). Defaults to "1.0" if unset.
AI_CHAT_PROMPT_VERSION=1.0

# Backs the AI chat feature's manual "Research this" button (real, live web
# search — see ai/README.md's "Online research" section). Optional: leave
# unset and the button simply doesn't appear. Get a free key at
# https://tavily.com (free tier: 1,000 requests/month, no credit card
# required — verified directly against tavily.com/pricing). Only takes
# effect when AI_PROVIDER=ollama (the default) — research isn't wired up
# for the Anthropic provider.
TAVILY_API_KEY=

# --- Brand asset uploads (services/storage.js) ---
#
# Optional — the web-design intake form's "Brand assets" upload and the
# admin dashboard's "View" button for them are unavailable (a clear 503, not
# a crash) until both of these are set. Get them from the Supabase
# dashboard: Project Settings → API → Project URL / service_role key.
#
# service_role bypasses Row Level Security and can read/write the entire
# project — keep it out of any frontend code and out of version control; it
# belongs only in this server-side env var.
#
# Create a bucket under Storage with this exact name, set to Private (not
# public) — signed URLs are how files are ever actually viewed (see
# adminController.getAssetSignedUrl), so the bucket itself should never be public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=brand-assets

# --- Contract PDF storage (services/contractPdf.js, contractController.js) ---
#
# Optional — reuses SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above, just a
# separate bucket, so contract PDFs and client brand-asset uploads never
# share storage. Same rule as above: create it under Storage with this
# exact name, set to Private (not public) — signed URLs are how a
# generated contract PDF is ever actually viewed/downloaded.
SUPABASE_CONTRACTS_BUCKET=contracts

# --- Remote Ollama control (adminController's ollama/* routes) ---
#
# Optional — lets an admin start/stop Ollama on whatever machine hosts it
# straight from the dashboard, without touching that machine directly. Only
# useful alongside the Tailscale setup in ai/README.md's "Remote Ollama
# control" section; leave both unset and the toggle just shows
# "not configured".
#
# OLLAMA_CONTROL_URL is the control helper's own Tailscale address, e.g.
# http://100.x.x.x:11435 (not the same port as Ollama itself, 11434).
# OLLAMA_CONTROL_SECRET must match the secret the helper was started with —
# treat it like a password; it's a bearer token, not a URL parameter.
OLLAMA_CONTROL_URL=
OLLAMA_CONTROL_SECRET=

# --- Error tracking (instrument.js) ---
#
# Optional — sign up at sentry.io (free tier is plenty for this app), create
# a Node project, and copy its DSN here. Leave unset to disable entirely;
# nothing about error handling changes, errors just aren't reported anywhere
# external. GET /api/health (unauthenticated, pings the DB) is separate from
# this — point an uptime monitor (UptimeRobot, Better Uptime, etc.) at that
# regardless of whether Sentry is configured.
SENTRY_DSN=

# --- BrindLeaf Guardian: AI safety control plane (guardian/aiControl.js) ---
#
# Leave BOTH unset in normal operation.
#
# BRINDLEAF_AI_ENABLED is the infrastructure-level emergency AI kill
# switch — only set it to the literal string "false" during an active
# incident, when you need every AI feature disabled and can't reach (or
# don't trust) the database-backed switch. Overrides any database state
# unconditionally. Needs a redeploy/restart to take effect — for a faster,
# no-redeploy kill switch, use `node guardian/setAiState.js lockdown
# --reason "..."` instead (see guardian/README.md's emergency runbook).
# Unset it again (don't leave it as "false") once the incident is resolved.
BRINDLEAF_AI_ENABLED=

# Set to "true" only if you deliberately want the boot-time file-integrity
# tripwire armed — on every boot, hashes ~14 security-critical files
# against the committed manifest (guardian/integrity-manifest.json) and, on
# a mismatch, logs a CRITICAL security event and locks AI down (never
# blocks the app itself from starting). Off by default so enabling it is a
# deliberate choice, not a default that could surprise a routine deploy.
GUARDIAN_INTEGRITY_CHECK_ON_BOOT=

# --- Security Center: read-only external status integrations
#     (guardian/railwayStatus.js, guardian/githubStatus.js,
#     guardian/sentryStatus.js) ---
#
# All three independently optional — the admin Security Center page shows
# "not configured" for whichever of these is left unset, never fake data.
# Every token here should be scoped to READ-ONLY access only; none of them
# are ever sent to the browser or echoed back in any API response.

# A Railway API token, scoped to this project only if Railway's dashboard
# offers project-scoped tokens (Project → Settings → Tokens) — safer than
# an account-wide personal token. Used to show real deployment status,
# timing, and history instead of just the bare commit SHA Railway already
# injects automatically.
RAILWAY_API_TOKEN=

# A GitHub fine-grained personal access token, scoped to this repo only,
# with Actions set to Read-only (Settings → Developer settings → Personal
# access tokens → Fine-grained tokens on github.com). Used to show whether
# CI actually passed for the currently-deployed commit.
GITHUB_TOKEN=
# owner/repo — only needed if this code is ever deployed from a fork; the
# app defaults to its own actual repo otherwise.
GITHUB_REPO=

# A Sentry internal-integration auth token (Organization Settings →
# Developer Settings → New Internal Integration, with Issue & Event set to
# Read) — distinct from SENTRY_DSN above, which is write-only for
# reporting errors. This one lets the app read error counts/stats back.
SENTRY_AUTH_TOKEN=
